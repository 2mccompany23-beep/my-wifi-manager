# Variables d'environnement pour abh2026-vote-kiosk
# COPIEZ ce fichier en .env et remplissez les valeurs AVANT tout déploiement

# ============================================================
# SÉCURITÉ DASHBOARD (obligatoire)
# ============================================================
# Mot de passe unique et fort pour accéder au dashboard admin
ADMIN_PASSWORD=changez_moi_maintenant_2026!

# Secret HMAC pour signer les tokens de session (min 32 chars aléatoires)
# Générez avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=REMPLACEZ_PAR_UNE_CHAINE_ALEATOIRE_DE_64_CARACTERES

# ============================================================
# POLLING SECRET (obligatoire pour le mode Cloud/CGNAT)
# ============================================================
# Token partagé entre le serveur Cloud et les routeurs MikroTik
# Générez avec: node -e "console.log(require('crypto').randomBytes(20).toString('hex'))"
POLL_SECRET_TOKEN=REMPLACEZ_PAR_TOKEN_ALEATOIRE_40_CHARS

# ============================================================
# CREDENTIALS ROUTEURS MIKROTIK (si différents des défauts)
# ============================================================
ROUTER1_HOST=192.168.1.161
ROUTER1_LAN=10.50.0.1
ROUTER1_USER=admin
ROUTER1_PASS=VOTRE_MOT_DE_PASSE_ROUTEUR_1

ROUTER2_HOST=192.168.1.162
ROUTER2_LAN=10.54.0.1
ROUTER2_USER=admin
ROUTER2_PASS=VOTRE_MOT_DE_PASSE_ROUTEUR_2

# ============================================================
# CONFIGURATION SERVEUR
# ============================================================
PORT=3000
CONNECTION_MODE=auto

# ============================================================
# ALWAYSDATA CLOUD (si déploiement cloud)
# ============================================================
CLOUD_BASE_URL=https://charmeldev.alwaysdata.net
# SFTP credentials — NE JAMAIS committer en git
SFTP_HOST=ssh-charmeldev.alwaysdata.net
SFTP_USERNAME=charmeldev_01
SFTP_PASSWORD=VOTRE_MOT_DE_PASSE_SFTP
